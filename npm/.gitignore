node_modules/
*.tgz

# Local npm auth config — may carry a registry token. Never commit.
.npmrc

# Real binaries are staged here only at CI publish time — never commit one.
# Glob on the binary basename (not a blanket bin/ ignore) so
# dragon-head-mcp/bin/run.js stays tracked; covers both the platform
# packages' bare "dragon-head-mcp"/".exe" and any future per-target rename.
platform/*/bin/dragon-head-mcp*
dragon-head-mcp/bin/dragon-head-mcp*
